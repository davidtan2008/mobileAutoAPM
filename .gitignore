# ── 构建产物 ────────────────────────────────────────────
# Swift / SwiftPM
.build/
*.o
*.dSYM
*.dSYM.zip

# Xcode
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa

# Node / RN
node_modules/
# rn-apm 的 tsc 编译产物（`npm run build` 生成；**根目录的 dist/ 是另一回事，见下**）
rn-apm/dist/
npm-debug.log*
yarn-error.log*
.metro-health-check*
ios/Pods/
android/.gradle/
android/build/
android/app/build/

# 鸿蒙
.hvigor/
oh_modules/
build/default/
local.properties

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 运行期数据 ──────────────────────────────────────────
# APM 工作区：基线应入库，原始测量产物不入库
.apm/runs/
*.trace
*.xcresult

# Demo 渲染中间产物：SVG 源与 MP4 入库，PNG 由 make demo-video 重新生成
docs/demo/**/slides/*.png
docs/demo/**/slides/render.json
docs/demo/**/*.stderr

# ── 编辑器 / 系统 ───────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── 敏感信息 ────────────────────────────────────────────
.env
.env.*
!.env.example
*.p12
*.mobileprovision
credentials.json
service-account*.json
